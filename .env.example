# Runtime
NODE_ENV=development
PORT=3000

# Postgres. 5433 is the host port exposed by docker compose.
DATABASE_URL=postgres://shelf:shelf@localhost:5433/shelf

# Google Books. The key is optional but recommended for a live demo:
# unkeyed traffic is quota-limited per IP and will eventually return 429.
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1/volumes

# When Google is down or out of quota, serve a clearly-labelled demo catalog
# instead of failing the search. Set to false to surface the 429 instead.
FALLBACK_CATALOG_ENABLED=true

# Browser origin allowed to call the API during development.
CLIENT_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy (nginx, Railway, Render)
# so cookies are marked secure and client IPs resolve correctly.
TRUST_PROXY=false
RATE_LIMIT_MAX=60
LOG_LEVEL=info
