{
  "name": "travelio-book-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Book search and wishlist app built for the Travelio engineering test",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors red,cyan \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "pnpm --filter @shelf/server dev",
    "dev:client": "pnpm --filter @shelf/client dev",
    "build": "pnpm --filter @shelf/server build && pnpm --filter @shelf/client build",
    "start": "node server/dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @shelf/server typecheck && pnpm --filter @shelf/client typecheck",
    "test": "pnpm --filter @shelf/server test && pnpm --filter @shelf/client test",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @shelf/server migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
